# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins.
# Web dev server (Vite) + any mobile emulator hosts. Use * to allow all (dev only).
# Android emulator reaches the host via 10.0.2.2.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://10.0.2.2:4000

# Public base URL of THIS api (used in links inside emails). No trailing slash.
APP_URL=http://localhost:4000
# Where the frontend lives (used for password-reset links in emails).
WEB_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite by default (zero setup). For production we use Neon Postgres:
#   1. schema.prisma provider is switched to "postgresql" at deploy time
#   2. set DATABASE_URL to your Neon pooled connection string (?sslmode=require)
DATABASE_URL="file:./dev.db"

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=30d

# ─── OTP (registration / reset) ────────────────────────────────────────────
# When EMAIL is configured the OTP is emailed. In dev with no email provider,
# set this true to also return the code in the API response for easy testing.
OTP_RETURN_IN_RESPONSE=true

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Get an API key at https://resend.com (free tier). Leave blank in dev to fall
# back to console logging (no email actually sent).
RESEND_API_KEY=
# The verified "from" address/domain in Resend. Until you verify a domain you
# can use the sandbox sender: onboarding@resend.dev
EMAIL_FROM="BRG Prime <onboarding@resend.dev>"

# ─── Payments (Paystack) ───────────────────────────────────────────────────
# Get TEST keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Default place Paystack redirects the browser after checkout (web app route).
PAYSTACK_CALLBACK_URL=http://localhost:5173/subscriptions
# Extra return addresses a client may request via `callbackUrl` on initialize.
# WEB_URL and PAYSTACK_CALLBACK_URL are always allowed, so this can stay empty.
# Only needed if a client returns somewhere else — e.g. a mobile deep link
# (brgprime://) once the app registers one. The mobile app currently uses an
# in-app WebView and returns to PAYSTACK_CALLBACK_URL, so it needs nothing here.
PAYSTACK_ALLOWED_CALLBACKS=

# ─── Image uploads (Cloudinary) ────────────────────────────────────────────
# Get this from the Cloudinary dashboard (Account Details → API Environment
# variable). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ─── BuildQ AI (AI quantity surveying) ───────────────────────────────────────
# BuildQ runs inside this same service and reuses the accounts above:
# DATABASE_URL, EMAIL_FROM/RESEND_API_KEY, PAYSTACK_*, CLOUDINARY_URL.
# Only these two are new.

# Claude — powers drawing analysis, BOQ generation and the assistant.
# The one credential BRG Prime had no existing equivalent of.
ANTHROPIC_API_KEY=

# Where the BuildQ frontend is served, for reset/invite links and Paystack returns.
# BuildQ lives under a sub-path of the BRG Prime site, so include the /boq prefix.
# Production: BUILDQ_WEB_URL=https://brgprime.com/boq
BUILDQ_WEB_URL=http://localhost:5173/boq

# Optional overrides.
# BUILDQ_MODEL=claude-opus-5
# BUILDQ_ACCESS_EXPIRES_IN=30m
# BUILDQ_REFRESH_EXPIRES_IN=30d
