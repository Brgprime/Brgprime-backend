# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins.
# Web dev server (Vite) + any mobile emulator hosts. Use * to allow all (dev only).
# Android emulator reaches the host via 10.0.2.2.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://10.0.2.2:4000

# Public base URL of THIS api (used in links inside emails). No trailing slash.
APP_URL=http://localhost:4000
# Where the frontend lives (used for password-reset links in emails).
WEB_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite by default (zero setup). For production we use Neon Postgres:
#   1. schema.prisma provider is switched to "postgresql" at deploy time
#   2. set DATABASE_URL to your Neon pooled connection string (?sslmode=require)
DATABASE_URL="file:./dev.db"

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=30d

# ─── OTP (registration / reset) ────────────────────────────────────────────
# When EMAIL is configured the OTP is emailed. In dev with no email provider,
# set this true to also return the code in the API response for easy testing.
OTP_RETURN_IN_RESPONSE=true

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Get an API key at https://resend.com (free tier). Leave blank in dev to fall
# back to console logging (no email actually sent).
RESEND_API_KEY=
# The verified "from" address/domain in Resend. Until you verify a domain you
# can use the sandbox sender: onboarding@resend.dev
EMAIL_FROM="BRG Prime <onboarding@resend.dev>"

# ─── Payments (Paystack) ───────────────────────────────────────────────────
# Get TEST keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack redirects the browser after checkout (web app route).
PAYSTACK_CALLBACK_URL=http://localhost:5173/subscriptions

# ─── Image uploads (Cloudflare R2, S3-compatible) ──────────────────────────
# Create a bucket + API token at Cloudflare dashboard → R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brg-prime
# Public base URL for the bucket (R2 public dev URL or your custom domain).
R2_PUBLIC_URL=
